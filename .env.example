# .env.example — copy to .env and fill in real values
# Never commit .env to version control.

# ----------------------------------------
# Django core
# ----------------------------------------
SECRET_KEY=
DJANGO_DEBUG=True

# ----------------------------------------
# Anthropic (AI features)
# ----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----------------------------------------
# Digital Ocean Spaces (file storage)
# ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=bonup-storage
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_REGION_NAME=nyc3

# ----------------------------------------
# LiveKit (live sessions)
# ----------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ----------------------------------------
# Stripe (billing)
#
# STRIPE_SECRET_KEY — leave empty to run in dev mode (direct DB plan changes allowed).
# Set to sk_live_... in production or sk_test_... for Stripe test mode.
#
# STRIPE_WEBHOOK_SECRET — from `stripe listen --forward-to ...` output (whsec_...).
# Required in production; optional locally if you skip signature verification.
#
# STRIPE_PRICE_ID_* — Stripe Price IDs for each monthly plan.
# Find these in the Stripe Dashboard → Products → Prices.
# ----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=
