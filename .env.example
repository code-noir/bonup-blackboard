# .env.example — copy to .env and fill in real values
# Never commit .env to version control.

# ----------------------------------------
# Django core
# ----------------------------------------
SECRET_KEY=
DJANGO_DEBUG=True

# ----------------------------------------
# PostgreSQL database
# ----------------------------------------
POSTGRES_DB=bonup_blackboard
POSTGRES_USER=bonup
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ----------------------------------------
# Anthropic (AI features)
# ----------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ----------------------------------------
# Digital Ocean Spaces (file storage)
# ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=bonup-storage
AWS_S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
AWS_S3_REGION_NAME=nyc3

# ----------------------------------------
# LiveKit (live sessions)
# ----------------------------------------
LIVEKIT_HOST=https://live.bonup.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ----------------------------------------
# Email
#
# Use console backend locally. For production, use Resend's HTTPS API backend.
# ----------------------------------------
FRONTEND_URL=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@bonup.cloud

# Production email delivery
# EMAIL_BACKEND=backend.core.email_backends.ResendEmailBackend
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT=10

# Legacy SMTP settings. Do not use these for production on hosts that block
# outbound SMTP ports.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# ----------------------------------------
# Stripe (billing)
#
# STRIPE_SECRET_KEY — leave empty to run in dev mode (direct DB plan changes allowed).
# Set to sk_live_... in production or sk_test_... for Stripe test mode.
#
# STRIPE_WEBHOOK_SECRET — from `stripe listen --forward-to ...` output (whsec_...).
# Required in production; optional locally if you skip signature verification.
#
# STRIPE_PRICE_ID_* — Stripe Price IDs for each monthly plan.
# Find these in the Stripe Dashboard → Products → Prices.
# ----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_ID_STARTER_MONTHLY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_BUSINESS_MONTHLY=
STRIPE_PRICE_ID_ENTERPRISE_MONTHLY=
