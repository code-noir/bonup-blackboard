[Unit]
Description=bonUP agent supervisor
After=local-fs.target
ConditionPathExists=/etc/bonup-agent-control/approved-installation.json
[Service]
Type=notify
User=root
Group=root
ExecStart=/usr/lib/bonup-agent-control/supervisor
WorkingDirectory=/
UMask=0077
Environment=PATH=/usr/bin:/bin LANG=C.UTF-8 LC_ALL=C.UTF-8 HOME=/nonexistent
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL CAP_DAC_READ_SEARCH
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices compatibility: HOST_TEST_REQUIRED
ReadWritePaths=/srv/bonup-agent-work /run/bonup-agent-supervisor
InaccessiblePaths=/var/lib/bonup-agent-control /run/bonup-agent-control
KillMode=control-group
KillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopSec=5s
WatchdogSec=10s
WatchdogSignal=SIGKILL
NotifyAccess=main
Restart=no
LimitCORE=0
LimitNOFILE=256
Delegate=cpu memory pids
DelegateSubgroup=supervisor
Sockets=bonup-agent-supervisor.socket
